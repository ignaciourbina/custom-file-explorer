{
  "name": "custom-file-explorer",
  "displayName": "Custom File Explorer",
  "description": "A detachable file explorer panel that opens as an editor tab and can be moved to a floating window. Pairs with the built-in explorer.",
  "version": "0.2.1",
  "publisher": "ignaciourbina",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "customFileExplorer.open",
        "title": "Open Custom File Explorer",
        "category": "Custom File Explorer"
      }
    ],
    "configuration": {
      "title": "Custom File Explorer",
      "properties": {
        "customFileExplorer.showHidden": {
          "type": "boolean",
          "default": false,
          "description": "Show hidden (dotfile) entries in the tree."
        },
        "customFileExplorer.excludeGlobs": {
          "type": "array",
          "items": { "type": "string" },
          "default": ["node_modules", ".git", "out", "dist", ".DS_Store"],
          "description": "Directory/file names to exclude from the tree."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "npx @vscode/vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.4.0"
  },
  "repository": {
    "type": "git",
    "url": ""
  },
  "license": "MIT"
}
